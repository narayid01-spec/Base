local FARM_TEXTS = {
    "CLIMB AND JUMP TOWER",
    "SET HEIGHT",
    "JUMP TIME",
    "AUTO COINS",
    "AUTO WINS"
}

local EVENT_TEXTS = {
    "ANGELS VS. DEMONS EVENT",
    "GOTO EVENT SERVER",
    "COLLECT BUFF",
    "COLLECT TOKENS",
    "BUY WINGS"
}

local function GetText(obj)

    local text = ""

    pcall(function()
        text = tostring(obj.Text or "")
    end)

    return string.lower(text)
end

local function ContainsAnyText(
    obj,
    signatures
)

    if not obj then
        return false
    end

    if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then

        local ownText =
            GetText(obj)

        for _,signature in ipairs(
            signatures
        ) do

            if string.find(
                ownText,
                string.lower(signature),
                1,
                true
            ) then

                return true
            end
        end
    end

    for _,desc in ipairs(
        obj:GetDescendants()
    ) do

        if desc:IsA("TextLabel")
            or desc:IsA("TextButton")
            or desc:IsA("TextBox") then

            local text =
                GetText(desc)

            for _,signature in ipairs(
                signatures
            ) do

                if string.find(
                    text,
                    string.lower(signature),
                    1,
                    true
                ) then

                    return true
                end
            end
        end
    end

    return false
end

local function CountSignatures(
    obj,
    signatures
)

    local count = 0

    for _,signature in ipairs(
        signatures
    ) do

        if ContainsAnyText(
            obj,
            {signature}
        ) then

            count += 1
        end
    end

    return count
end

local function FindTextObject(
    screenGui,
    text
)

    local target =
        string.lower(text)

    for _,obj in ipairs(
        screenGui:GetDescendants()
    ) do

        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            local current =
                GetText(obj)

            if string.find(
                current,
                target,
                1,
                true
            ) then

                return obj
            end
        end
    end

    return nil
end

local function FindPanel(
    screenGui,
    signatures
)

    local first =
        FindTextObject(
            screenGui,
            signatures[1]
        )

    if not first then
        return nil
    end

    local current =
        first.Parent

    local best = nil

    while current
        and current ~= screenGui do

        if current:IsA("GuiObject") then

            local matched =
                CountSignatures(
                    current,
                    signatures
                )

            local size =
                current.AbsoluteSize

            local area =
                size.X * size.Y

            if matched >= 2
                and size.X > 20
                and size.Y > 20
                and size.X < 1000
                and size.Y < 800
                and area < 700000 then

                best = current
            end
        end

        current =
            current.Parent
    end

    return best
end

--========================================================
-- MOUNT
--========================================================

local Mounted = {}

local function MountPanel(
    panel,
    slot
)

    if not panel
        or not slot then

        return false
    end

    if Mounted[panel] then
        return true
    end

    task.wait()

    local originalSize =
        panel.AbsoluteSize

    if originalSize.X <= 1
        or originalSize.Y <= 1 then

        return false
    end

    panel.Parent = slot

    panel.AnchorPoint =
        Vector2.new(0.5,0.5)

    panel.Position =
        UDim2.fromScale(0.5,0.5)

    panel.Size =
        UDim2.fromOffset(
            originalSize.X,
            originalSize.Y
        )

    panel.Visible = true

    local scale =
        panel:FindFirstChild(
            "__VORTEX_SCALE"
        )

    if scale then
        scale:Destroy()
    end

    scale =
        Instance.new("UIScale")

    scale.Name =
        "__VORTEX_SCALE"

    scale.Parent = panel

    local function Update()

        if not panel
            or not panel.Parent then

            return
        end

        local slotSize =
            slot.AbsoluteSize

        local sx =
            (slotSize.X - 10) /
            originalSize.X

        local sy =
            (slotSize.Y - 10) /
            originalSize.Y

        scale.Scale =
            math.clamp(
                math.min(sx,sy),
                0.25,
                1
            )

        panel.AnchorPoint =
            Vector2.new(0.5,0.5)

        panel.Position =
            UDim2.fromScale(0.5,0.5)

        panel.Size =
            UDim2.fromOffset(
                originalSize.X,
                originalSize.Y
            )

        panel.Visible = true
    end

    Update()

    Mounted[panel] = true

    task.spawn(function()

        while Vortex
            and Vortex.Parent
            and panel
            and panel.Parent == slot do

            Update()

            task.wait(0.08)
        end

        Mounted[panel] = nil
    end)

    return true
end

