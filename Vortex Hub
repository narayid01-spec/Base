-- GET SC1 GUIS
--========================================================

local function GetAllScreenGuis()

    local list = {}

    for _,gui in ipairs(
        CoreGui:GetChildren()
    ) do

        if gui:IsA("ScreenGui")
            and gui ~= Vortex then

            table.insert(
                list,
                gui
            )
        end
    end

    local pg =
        Player:FindFirstChild(
            "PlayerGui"
        )

    if pg then

        for _,gui in ipairs(
            pg:GetChildren()
        ) do

            if gui:IsA("ScreenGui")
                and gui ~= Vortex then

                table.insert(
                    list,
                    gui
                )
            end
        end
    end

    return list
end

