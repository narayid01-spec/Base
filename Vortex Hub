local function HideRequestedText(root)

    if not root then
        return
    end

    for _,obj in ipairs(
        root:GetDescendants()
    ) do

        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            local text = ""

            pcall(function()
                text =
                    string.lower(
                        tostring(
                            obj.Text or ""
                        )
                    )
            end)

            if string.find(
                text,
                "climb and jump tower",
                1,
                true
            )
            or string.find(
                text,
                "angels vs. demons event",
                1,
                true
            )
            or string.find(
                text,
                "angels vs demons event",
                1,
                true
            )
            or string.find(
                text,
                "youtube: tora isme",
                1,
                true
            ) then

                obj.Visible = false
            end
        end
    end
end

