-- MOUNT SC1
--========================================================

task.spawn(function()

    local farmDone = false
    local eventDone = false

    for attempt = 1,180 do

        task.wait(0.5)

        local guis =
            GetAllScreenGuis()

        if not farmDone then

            for _,gui in ipairs(guis) do

                local panel =
                    FindPanel(
                        gui,
                        FARM_TEXTS
                    )

                if panel then

                    if MountPanel(
                        panel,
                        FarmSlot
                    ) then

                        farmDone = true

                        HideRequestedText(
                            panel
                        )

                        break
                    end
                end
            end
        end

        if not eventDone then

            for _,gui in ipairs(guis) do

                local panel =
                    FindPanel(
                        gui,
                        EVENT_TEXTS
                    )

                if panel then

                    if MountPanel(
                        panel,
                        EventSlot
                    ) then

                        eventDone = true

                        HideRequestedText(
                            panel
                        )

                        break
                    end
                end
            end
        end

        if farmDone
            and eventDone then

            break
        end
    end
end)

