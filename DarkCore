--========================================================
-- PERSISTENT SETTINGS
--========================================================
-- Uses the executor's file API when available. This is intentionally
-- client-side persistence: it restores this hub's settings on the same
-- device/executor. Roblox DataStoreService itself is server-side and
-- cannot be accessed directly by a client LocalScript.

local SETTINGS_FILE = "DarkCore_RideAPet_Settings.json"
local FilePersistenceAvailable = type(readfile) == "function" and type(writefile) == "function"
    and type(isfile) == "function"

local function CFrameToArray(cf)
    if typeof(cf) ~= "CFrame" then return nil end
    local x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22 = cf:GetComponents()
    return {x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22}
end

local function ArrayToCFrame(data)
    if type(data) ~= "table" or #data < 12 then return nil end
    local ok, cf = pcall(function()
        return CFrame.new(table.unpack(data,1,12))
    end)
    return ok and cf or nil
end

local function BuildSettings()
    local autoSelected = {}
    for key, value in pairs(State.AutoSelected) do
        if value == true then
            autoSelected[key] = true
        end
    end

    return {
        Version = 2,
        AutoEgg = State.AutoEgg == true,
        AutoInstant = State.AutoInstant == true,
        SelectedEgg = State.SelectedEgg,
        AutoSelected = autoSelected,
        Noclip = State.Noclip == true,
        ESP = State.ESP == true,
        AntiAFK = State.AntiAFK == true,
        WalkSpeed = State.WalkSpeed,
        JumpPower = State.JumpPower,
        TravelSpeed = State.TravelSpeed,
        FlySpeed = State.FlySpeed,
        Spawn = CFrameToArray(State.Spawn),
    }
end

local function SaveSettings()
    if not FilePersistenceAvailable then return false end

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(BuildSettings())
    end)
    if not ok then return false end

    return pcall(function()
        writefile(SETTINGS_FILE, encoded)
    end)
end

local function LoadSettings()
    if not FilePersistenceAvailable then return false end
    if not pcall(function() return isfile(SETTINGS_FILE) end) then return false end

    local exists = false
    pcall(function() exists = isfile(SETTINGS_FILE) end)
    if not exists then return false end

    local okRead, raw = pcall(readfile, SETTINGS_FILE)
    if not okRead or type(raw) ~= "string" or raw == "" then return false end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not okDecode or type(data) ~= "table" then return false end

    State.AutoEgg = data.AutoEgg == true
    State.AutoInstant = data.AutoInstant == true
    State.SelectedEgg = type(data.SelectedEgg) == "string" and data.SelectedEgg or nil

    State.AutoSelected = {}
    if type(data.AutoSelected) == "table" then
        for key, value in pairs(data.AutoSelected) do
            if type(key) == "string" and value == true then
                State.AutoSelected[key] = true
            end
        end
    end

    State.Noclip = data.Noclip == true
    State.ESP = data.ESP == true
    State.AntiAFK = data.AntiAFK == true

    if tonumber(data.WalkSpeed) then State.WalkSpeed = math.clamp(tonumber(data.WalkSpeed),1,500) end
    if tonumber(data.JumpPower) then State.JumpPower = math.clamp(tonumber(data.JumpPower),1,500) end
    if tonumber(data.TravelSpeed) then State.TravelSpeed = math.clamp(tonumber(data.TravelSpeed),1,1000) end
    if tonumber(data.FlySpeed) then State.FlySpeed = math.clamp(tonumber(data.FlySpeed),1,1000) end

    local loadedSpawn = ArrayToCFrame(data.Spawn)
    if loadedSpawn then State.Spawn = loadedSpawn end

    return true
end

