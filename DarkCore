local function StopTravel()
    State.Travel=false
    State.Returning=false
    State.TravelToken+=1

    local root=GetRoot()
    if root then root.AssemblyLinearVelocity=Vector3.zero end

    if DashTravel.Parent then DashTravel.Text="Travel: Stopped" end
end

local function TravelToEgg(object, speedOverride)
    if not object or not object.Parent then return false end

    local root=GetRoot()
    if not root then return false end

    State.TravelToken+=1
    local token=State.TravelToken
    State.Travel=true
    State.Returning=false

    DashTravel.Text="Travel: Travelling to Egg"

    while State.Travel
    and not State.Returning
    and token==State.TravelToken
    and object
    and object.Parent do

        root=GetRoot()
        if not root then break end

        local position=GetObjectPosition(object)
        if not position then break end

        local offset=position-root.Position
        local distance=offset.Magnitude

        if distance<=7 then
            root.AssemblyLinearVelocity=Vector3.zero
            return true
        end

        root.AssemblyLinearVelocity=offset.Unit*math.clamp(speedOverride or State.TravelSpeed,1,1000)
        RunService.Heartbeat:Wait()
    end

    if root then root.AssemblyLinearVelocity=Vector3.zero end
    return false
end

local function ReturnToFirstSpawn(speedOverride)
    local first = GetFirstSpawn()
    if not first then
        CaptureFirstSpawn()
        first = GetFirstSpawn()
    end
    if not first then return false end

    local root = GetRoot()
    if not root then return false end

    State.TravelToken += 1
    local token = State.TravelToken
    State.Travel = true
    State.Returning = true
    DashTravel.Text = "Travel: Returning to First Spawn"

    local target = first.Position
    while State.Travel and State.Returning and token == State.TravelToken do
        root = GetRoot()
        if not root then break end
        local offset = target - root.Position
        local distance = offset.Magnitude
        if distance <= 7 then
            root.CFrame = first
            root.AssemblyLinearVelocity = Vector3.zero
            State.Travel = false
            State.Returning = false
            DashTravel.Text = "Travel: At First Spawn"
            return true
        end
        root.AssemblyLinearVelocity = offset.Unit * math.clamp(speedOverride or State.TravelSpeed,1,1000)
        RunService.Heartbeat:Wait()
    end
    if root then root.AssemblyLinearVelocity = Vector3.zero end
    State.Returning = false
    return false
end

local function ReturnToSpawn()
    if not State.Spawn then SaveSpawn() end
    if not State.Spawn then return false end

    local root=GetRoot()
    if not root then return false end

    State.TravelToken+=1
    local token=State.TravelToken
    State.Travel=true
    State.Returning=true

    DashTravel.Text="Travel: Returning to Spawn"

    local target=State.Spawn.Position

    while State.Travel
    and State.Returning
    and token==State.TravelToken do

        root=GetRoot()
        if not root then break end

        local offset=target-root.Position
        local distance=offset.Magnitude

        if distance<=7 then
            root.CFrame=State.Spawn
            root.AssemblyLinearVelocity=Vector3.zero
            State.Travel=false
            State.Returning=false
            DashTravel.Text="Travel: At Spawn"
            return true
        end

        root.AssemblyLinearVelocity=offset.Unit*math.clamp(State.TravelSpeed,1,1000)
        RunService.Heartbeat:Wait()
    end

    if root then root.AssemblyLinearVelocity=Vector3.zero end
    return false
end

local function TakeSelectedEgg()
    local object=FindSelectedEgg()
    if not object then
        DashTravel.Text="Travel: Egg Not Found"
        return
    end

    task.spawn(function()
        StopTravel()
        local reached=TravelToEgg(object)

        if reached and object and object.Parent then
            task.wait(0.12)
            local ok=Interact(object)
            DashTravel.Text=ok and "Travel: Egg Taken" or "Travel: Interaction Failed"
        end
    end)
end

