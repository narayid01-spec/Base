local function StartFly()
    if State.Travel or State.Returning or State.AutoEgg or State.AutoInstant then
        return
    end

    StopFly()
    State.Fly=true
    SetButtonState(FlyButton,true,"FLY: ON","FLY: OFF")

    FlyConnection=RunService.RenderStepped:Connect(function()
        if not State.Fly or State.Travel or State.Returning or State.AutoEgg or State.AutoInstant then
            return
        end

        local root=GetRoot()
        if not root then
            StopFly()
            return
        end

        local camera=workspace.CurrentCamera
        if not camera then return end

        local move=Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then move+=camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move-=camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move-=camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move+=camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move+=Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move-=Vector3.yAxis end

        if move.Magnitude>0 then
            root.AssemblyLinearVelocity=move.Unit*math.clamp(State.FlySpeed,1,1000)
        else
            root.AssemblyLinearVelocity=Vector3.zero
        end
    end)
end

