local function NormalizeName(value)
    value = tostring(value or "")
    value = value:gsub("[%c]","")
    value = value:gsub("%s+"," ")
    value = value:match("^%s*(.-)%s*$") or ""
    return string.lower(value)
end

local function GetEggName(object)
    if not object then return nil end
    local n = NormalizeName(object.Name)
    if EggLookup[n] then return EggLookup[n] end
    if n:find("egg",1,true) then return object.Name end
    return nil
end

local function GetObjectPosition(object)
    if not object or not object.Parent then return nil end
    if object:IsA("BasePart") then return object.Position end

    if object:IsA("Model") then
        local ok,p = pcall(function() return object:GetPivot() end)
        if ok and p then return p.Position end
    end

    local part = object:FindFirstChildWhichIsA("BasePart",true)
    return part and part.Position or nil
end

local function IsInsideCharacter(object)
    local character = LocalPlayer.Character
    return character and object:IsDescendantOf(character)
end

local function FindEggContainer(object)
    if not object then return nil end

    local current = object
    while current and current ~= workspace do
        if current:IsA("Model") and GetEggName(current) then
            return current
        end
        current = current.Parent
    end

    if object:IsA("BasePart") and GetEggName(object) then
        return object
    end

    return nil
end

local function AddCandidate(object)
    if not object or IsInsideCharacter(object) then return end
    local candidate = FindEggContainer(object)
    if candidate and candidate.Parent then
        State.EggCandidates[candidate] = true
    end
end

local function RemoveCandidate(object)
    State.EggCandidates[object] = nil
    for candidate in pairs(State.EggCandidates) do
        if not candidate or not candidate.Parent or (object and candidate:IsDescendantOf(object)) then
            State.EggCandidates[candidate] = nil
        end
    end
end

Connect(workspace.DescendantAdded,function(object)
    AddCandidate(object)
end)

Connect(workspace.DescendantRemoving,function(object)
    RemoveCandidate(object)
end)

task.spawn(function()
    local descendants = workspace:GetDescendants()
    for i,object in ipairs(descendants) do
        AddCandidate(object)
        if i % 400 == 0 then task.wait() end
    end
end)

local function ScanEggs()
    local root = GetRoot()
    if not root then return {} end

    local results = {}
    local seen = {}

    for object in pairs(State.EggCandidates) do
        if object and object.Parent and not IsInsideCharacter(object) then
            local name = GetEggName(object)
            local position = GetObjectPosition(object)

            if name and position and not seen[object] then
                local distance = (position-root.Position).Magnitude
                if distance >= MIN_SCAN_DISTANCE then
                    seen[object] = true
                    results[#results+1] = {
                    Name = name,
                    Object = object,
                    Position = position,
                    Distance = distance
                    }
                end
            end
        end
    end

    table.sort(results,function(a,b)
        if a.Distance == b.Distance then
            return NormalizeName(a.Name) < NormalizeName(b.Name)
        end
        return a.Distance < b.Distance
    end)

    return results
end

