    State.Returning=false

    if StopFly then StopFly() end

    State.SelectedObject=nil
    State.Eggs={}
    State.EggCandidates={}
    State.EggMap={}
    State.LastScanSignature=""

    State.Character=character
    State.Humanoid=character:WaitForChild("Humanoid",8)
    State.Root=character:WaitForChild("HumanoidRootPart",8)

    if State.Noclip then
        task.defer(function() ApplyNoclip(character) end)
    end

    if State.Humanoid then
        State.Humanoid.WalkSpeed=State.WalkSpeed
        State.Humanoid.JumpPower=State.JumpPower
    end

    CharacterStatus.Text="Character: Ready"
    CharacterStatus.TextColor3=C.Green
    if State.SelectedEgg then
        SelectedLabel.Text="Selected: "..State.SelectedEgg
        DashSelected.Text="Selected Egg: "..State.SelectedEgg
    else
        SelectedLabel.Text="Selected: None"
        DashSelected.Text="Selected Egg: None"
    end

    task.wait(0.5)
    if not State.FirstSpawn then
        CaptureFirstSpawn()
    end
    SaveSpawn()
    SpawnStatus.Text = State.FirstSpawn and "Spawn: First Spawn Locked" or "Spawn: Saved"

    for _,object in ipairs(workspace:GetDescendants()) do
        AddCandidate(object)
    end

    ScanAndRefresh(true)
    RefreshAutoSelector()

    -- Restore persisted automation after the new character is ready.
    if State.AutoEgg and AutoCount() > 0 then
        task.delay(0.4, function()
            if ScreenGui and ScreenGui.Parent and State.AutoEgg then
                StartAutoEgg()
            end
        end)
    elseif State.AutoInstant and AutoCount() > 0 then
        task.delay(0.4, function()
            if ScreenGui and ScreenGui.Parent and State.AutoInstant then
                StartAutoInstant()
            end
        end)
    end

    SaveSettings()
end)

