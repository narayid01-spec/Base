local function ScanAndRefresh(force)
    local results=ScanEggs()
    local sig={}

    for _,egg in ipairs(results) do
        sig[#sig+1]=NormalizeName(egg.Name)..":"..
            math.floor(egg.Position.X/15)..":"..
            math.floor(egg.Position.Y/15)..":"..
            math.floor(egg.Position.Z/15)
    end

    local signature=table.concat(sig,"|")
    State.Eggs=results

    State.EggMap={}
    for _,egg in ipairs(results) do
        local key=NormalizeName(egg.Name)
        local old=State.EggMap[key]
        if not old or egg.Distance<old.Distance then
            State.EggMap[key]=egg
        end
    end

    if State.SelectedObject and not State.SelectedObject.Parent then
        State.SelectedObject=nil
        State.SelectedEgg=nil
        SelectedLabel.Text="Selected: None"
        DashSelected.Text="Selected Egg: None"
    end

    if force or signature~=State.LastScanSignature then
        State.LastScanSignature=signature
        RefreshEggList()
        if State.ESP then RefreshESP() end
    end

    return results
end

local function FindSelectedEgg()
    if State.SelectedObject and State.SelectedObject.Parent and State.SelectedEgg then
        local n=GetEggName(State.SelectedObject)
        if n and NormalizeName(n)==NormalizeName(State.SelectedEgg) then
            return State.SelectedObject
        end
    end

    if State.SelectedEgg then
        local wanted=NormalizeName(State.SelectedEgg)
        for _,egg in ipairs(State.Eggs) do
            if NormalizeName(egg.Name)==wanted and egg.Object and egg.Object.Parent then
                State.SelectedObject=egg.Object
                return egg.Object
            end
        end
    end

    return nil
end

