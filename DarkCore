    if State.Humanoid then
        State.Humanoid.WalkSpeed=State.WalkSpeed
        State.Humanoid.JumpPower=State.JumpPower
    end

    WalkBox.Text=tostring(State.WalkSpeed)
    JumpBox.Text=tostring(State.JumpPower)
    FlySpeedBox.Text=tostring(State.FlySpeed)
    TravelSpeedBox.Text=tostring(State.TravelSpeed)
    SaveSettings()
end)

