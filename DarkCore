local function UpdateCharacter()
    local character = LocalPlayer.Character
    if not character then return false end

    State.Character = character
    State.Humanoid = character:FindFirstChildOfClass("Humanoid")
    State.Root = character:FindFirstChild("HumanoidRootPart")

    return State.Root ~= nil
end

local function GetRoot()
    if not State.Character
    or not State.Character.Parent
    or not State.Root
    or not State.Root.Parent then
        UpdateCharacter()
    end
    return State.Root
end

local function SaveSpawn()
    local root = GetRoot()
    if not root then return false end
    State.Spawn = root.CFrame
    return true
end

-- V10: capture the player's first spawn once per session.
-- Auto Egg uses this locked location and never overwrites it after respawn.
State.FirstSpawn = nil

local function CaptureFirstSpawn()
    if State.FirstSpawn then return true end
    local root = GetRoot()
    if not root then return false end
    State.FirstSpawn = root.CFrame
    return true
end

local function GetFirstSpawn()
    return State.FirstSpawn
end

