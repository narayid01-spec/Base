local function MakeDraggable(object, handle)
    handle = handle or object
    local dragging = false
    local dragStart
    local startPos
    local inputConnection

    Connect(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            inputConnection = input
        end
    end)

    Connect(handle.InputEnded, function(input)
        if input == inputConnection then
            dragging = false
            inputConnection = nil
        end
    end)

    Connect(UIS.InputChanged, function(input)
        if not dragging or not dragStart or not startPos then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart
        object.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end)
end

local function SetButtonState(button, enabled, onText, offText)
    if not button or not button.Parent then return end
    button.Text = enabled and onText or offText
    button.BackgroundColor3 = enabled and C.Selected or C.Button
    button:SetAttribute("VensSelected", enabled)
end

