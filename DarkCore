local function FindInteraction(object)
    if not object then return nil end

    if object:IsA("ProximityPrompt") or object:IsA("ClickDetector") then
        return object
    end

    local prompt=object:FindFirstChildWhichIsA("ProximityPrompt",true)
    if prompt then return prompt end

    return object:FindFirstChildWhichIsA("ClickDetector",true)
end

local function Interact(object)
    if not object or not object.Parent then return false end

    local interaction=FindInteraction(object)
    if not interaction then return false end

    if interaction:IsA("ProximityPrompt") then
        if type(fireproximityprompt)=="function" then
            local ok=pcall(function()
                fireproximityprompt(interaction,1,true)
            end)
            if ok then return true end
        end

        local ok=pcall(function()
            interaction:InputHoldBegin()
            task.wait(math.max(0.08,tonumber(interaction.HoldDuration) or 0.08))
            interaction:InputHoldEnd()
        end)
        return ok
    end

    if interaction:IsA("ClickDetector") and type(fireclickdetector)=="function" then
        return pcall(function() fireclickdetector(interaction) end)
    end

    return false
end

