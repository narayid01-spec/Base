local function StopAuto()
    State.AutoEgg=false
    State.AutoInstant=false
    State.AutoToken+=1

    SetButtonState(AutoEggButton,false,"AUTO EGG  •  ON","AUTO EGG  •  OFF")
    SetButtonState(AutoInstantButton,false,"INSTANT  •  ON","INSTANT  •  OFF")

    AutoStatus.Text="Status: OFF • waiting for selection"
    DashAuto.Text="Auto: OFF"

    StopTravel()
    SaveSettings()
end

local function StartAutoEgg()
    -- Only stop the competing modes; do not invalidate the new worker after creating it.
    State.AutoToken+=1
    local token=State.AutoToken

    State.AutoEgg=true
    State.AutoInstant=false
    StopTravel()

    SetButtonState(AutoEggButton,true,"AUTO EGG  •  ON","AUTO EGG  •  OFF")
    SetButtonState(AutoInstantButton,false,"INSTANT  •  ON","INSTANT  •  OFF")
    DashAuto.Text="Auto: Egg"
    SaveSettings()

    task.spawn(function()
        local processed={}

        while State.AutoEgg and token==State.AutoToken do
            if AutoCount()<=0 then
                AutoStatus.Text="Status: Select egg first"
                task.wait(0.5)
                continue
            end

            ScanAndRefresh(false)

            for object in pairs(processed) do
                if not object or not object.Parent then
                    processed[object]=nil
                end
            end

            local target
            for _,egg in ipairs(State.Eggs) do
                if State.AutoSelected[NormalizeName(egg.Name)]
                and egg.Object
                and egg.Object.Parent
                and not processed[egg.Object] then
                    target=egg
                    break
                end
            end

            if not target then
                AutoStatus.Text="Status: Egg Not Found"
                task.wait(0.5)
                continue
            end

            local object=target.Object
            AutoStatus.Text="Status: Taking "..target.Name

            StopTravel()
            local reached=TravelToEgg(object, AUTO_EGG_SPEED)

            if not (State.AutoEgg and token==State.AutoToken) then break end

            if reached and object and object.Parent then
                task.wait(0.12)
                local success=Interact(object)

                if success then
                    processed[object]=true
                    AutoStatus.Text="Status: Taken "..target.Name
                    task.wait(0.2)
                    if State.AutoEgg and token==State.AutoToken then
                        ReturnToFirstSpawn(AUTO_EGG_SPEED)
                    end
                else
                    AutoStatus.Text="Status: Interaction Failed"
                    processed[object]=true
                    task.wait(0.4)
                end
            end

            task.wait(0.2)
        end
    end)
end

local function InstantTeleportAndInteract(object)
    if not object or not object.Parent then return false end

    local root=GetRoot()
    if not root then return false end

    local position=GetObjectPosition(object)
    if not position then return false end

    root.CFrame=CFrame.new(position+Vector3.new(0,3,0))
    root.AssemblyLinearVelocity=Vector3.zero

    task.wait(0.15)

    local success=Interact(object)

    task.wait(0.15)

    root=GetRoot()
    if root and State.Spawn then
        root.CFrame=State.Spawn
        root.AssemblyLinearVelocity=Vector3.zero
    end

    return success
end

local function StartAutoInstant()
    State.AutoToken+=1
    local token=State.AutoToken

    State.AutoEgg=false
    State.AutoInstant=true
    StopTravel()

    SetButtonState(AutoEggButton,false,"AUTO EGG  •  ON","AUTO EGG  •  OFF")
    SetButtonState(AutoInstantButton,true,"INSTANT  •  ON","INSTANT  •  OFF")
    DashAuto.Text="Auto: Instant"
    SaveSettings()

    if StopFly then StopFly() end

    task.spawn(function()
        local processed={}

        while State.AutoInstant and token==State.AutoToken do
            if AutoCount()<=0 then
                AutoStatus.Text="Status: Select egg first"
                task.wait(0.5)
                continue
            end

            ScanAndRefresh(false)

            for object in pairs(processed) do
                if not object or not object.Parent then
                    processed[object]=nil
                end
            end

            local target
            for _,egg in ipairs(State.Eggs) do
                if State.AutoSelected[NormalizeName(egg.Name)]
                and egg.Object
                and egg.Object.Parent
                and not processed[egg.Object] then
                    target=egg
                    break
                end
            end

            if not target then
                AutoStatus.Text="Status: Egg Not Found"
                task.wait(0.5)
                continue
            end

            AutoStatus.Text="Status: Taking "..target.Name

            local success=InstantTeleportAndInteract(target.Object)

            if success then
                processed[target.Object]=true
                AutoStatus.Text="Status: Taken "..target.Name
            else
                processed[target.Object]=true
                AutoStatus.Text="Status: Interaction Failed"
            end

            task.wait(0.25)
        end
    end)
end

