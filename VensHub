local function ScanEggs()
    local root = GetRoot()
    if not root then
        return {}
    end

    local results = {}
    local seenObjects = {}
    local seenPhysical = {}

    for object in pairs(State.EggCandidates) do
        if object and object.Parent and not IsInsideLocalCharacter(object) then
            local eggName = GetEggName(object)
            local position = GetObjectPosition(object)

            if eggName and position then
                local distance = (position - root.Position).Magnitude

                -- Strictly farther than 500 studs.
                if distance > MIN_SCAN_DISTANCE then
                    local physicalKey = object

                    if not seenObjects[object] and not seenPhysical[physicalKey] then
                        seenObjects[object] = true
                        seenPhysical[physicalKey] = true

                        results[#results + 1] = {
                            Name = eggName,
                            Object = object,
                            Position = position,
                            Distance = distance,
                        }
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Distance == b.Distance then
            return NormalizeName(a.Name) < NormalizeName(b.Name)
        end
        return a.Distance < b.Distance
    end)

    return results
end

