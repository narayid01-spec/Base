task.spawn(function()

    while ScreenGui.Parent do

        task.wait(0.5)


        DashEggs.Text =
            "Scanned Eggs: "
            .. #State.Eggs


        if State.SelectedEgg then

            DashSelected.Text =
                "Selected Egg: "
                .. State.SelectedEgg

        else

            DashSelected.Text =
                "Selected Egg: None"
        end


        if State.Travel then

            if State.Returning then

                DashTravel.Text =
                    "Travel: Returning"

            else

                DashTravel.Text =
                    "Travel: Travelling"
            end

        elseif not State.Travel then

            if DashTravel.Text ==
                "Travel: Travelling"
                or DashTravel.Text ==
                "Travel: Returning" then

                DashTravel.Text =
                    "Travel: Idle"
            end
        end


        if State.AutoEgg then

            DashAuto.Text =
                "Auto: Egg"

        elseif State.AutoInstant then

            DashAuto.Text =
                "Auto: Instant"

        else

            DashAuto.Text =
                "Auto: OFF"
        end


        DashActivity.Text =
            "Activity: "
            .. #State.Activity


        local elapsed =
            os.time()
            - State.SessionStart

        local minutes =
            math.floor(
                elapsed / 60
            )

        SessionStatus.Text =
            "Session: "
            .. tostring(minutes)
            .. "m • "
            .. tostring(
                State.LastStatus
            )
    end
end)


