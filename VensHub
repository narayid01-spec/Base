local EggLookup = {
    ["soul egg"] = "Soul Egg",
    ["volcanic egg"] = "Volcanic Egg",
    ["dominus egg"] = "Dominus Egg",
    ["blackhole egg"] = "Blackhole Egg",
    ["black hole egg"] = "Blackhole Egg",
    ["galaxy egg"] = "Galaxy Egg",
    ["legendary egg"] = "Legendary Egg",
    ["mythic egg"] = "Mythic Egg",
    ["divine egg"] = "Divine Egg",
    ["secret egg"] = "Secret Egg",
    ["rainbow egg"] = "Rainbow Egg",
    ["golden egg"] = "Golden Egg",
    ["lava egg"] = "Lava Egg",
    ["ice egg"] = "Ice Egg",
    ["fire egg"] = "Fire Egg",
    ["forest egg"] = "Forest Egg",
    ["desert egg"] = "Desert Egg",
    ["water egg"] = "Water Egg",
    ["sky egg"] = "Sky Egg",
}


local function GetEggName(object)

    if not object then
        return nil
    end

    local normalized =
        NormalizeName(
            object.Name
        )

    if EggLookup[normalized] then
        return EggLookup[normalized]
    end

    if normalized:find(
        "egg",
        1,
        true
    ) then

        return object.Name
    end

    return nil
end


local function GetObjectPosition(object)

    if not object
        or not object.Parent then

        return nil
    end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then

        local success, pivot =
            pcall(function()
                return object:GetPivot()
            end)

        if success and pivot then
            return pivot.Position
        end
    end

    local part =
        object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end


local function IsLocalCharacterObject(object)

    local character =
        LocalPlayer.Character

    return character
        and object
        and object:IsDescendantOf(
            character
        )
end


local function GetEggContainer(object)

    if not object then
        return nil
    end

    local current = object

    while current
        and current ~= workspace do

        if current:IsA("Model")
            and GetEggName(current) then

            return current
        end

        current = current.Parent
    end

    if object:IsA("BasePart")
        and GetEggName(object) then

        return object
    end

    return nil
end


local function RegisterCandidate(object)

    if not object then
        return
    end

    if IsLocalCharacterObject(object) then
        return
    end

    local candidate =
        GetEggContainer(object)

    if candidate
        and candidate.Parent then

        State.EggCandidates[candidate] =
            true
    end
end


for _, object in ipairs(
    workspace:GetDescendants()
) do

    RegisterCandidate(object)
end


Connect(
    workspace.DescendantAdded,
    function(object)

        RegisterCandidate(object)
    end
)


Connect(
    workspace.DescendantRemoving,
    function(object)

        State.EggCandidates[object] =
            nil
    end
)


