local function Button(parent, text, size, position)
    local object = Instance.new("TextButton")
    object.Size = size
    object.Position = position
    object.BackgroundColor3 = C.Button
    object.BackgroundTransparency = 0.04
    object.BorderSizePixel = 0
    object.Text = text
    object.TextColor3 = C.White
    object.TextSize = 11
    object.Font = Enum.Font.GothamMedium
    object.AutoButtonColor = false
    object.Active = true
    object.Selectable = false
    object.ZIndex = 30
    object.Parent = parent
    Corner(object, 8)
    local outline = Stroke(object, Color3.fromRGB(48, 42, 60), 1, 0.25)

    Connect(object.MouseEnter, function()
        if object.Parent and object.BackgroundColor3 ~= C.Selected then
            object.BackgroundColor3 = C.Hover
            outline.Transparency = 0.05
        end
    end)

    Connect(object.MouseLeave, function()
        if object.Parent and object.BackgroundColor3 ~= C.Selected then
            object.BackgroundColor3 = C.Button
            outline.Transparency = 0.25
        end
    end)

    Connect(object.MouseButton1Down, function()
        if object.Parent and object.BackgroundColor3 ~= C.Selected then
            object.BackgroundColor3 = C.Selected
        end
    end)

    Connect(object.MouseButton1Up, function()
        if object.Parent and object.BackgroundColor3 == C.Selected then
            -- Preserve selected tab state; otherwise return to normal.
            if object:GetAttribute("VensSelected") ~= true then
                object.BackgroundColor3 = C.Hover
            end
        end
    end)

    return object
end

