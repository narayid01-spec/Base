local ESPObjects = {}


local function ClearESP()

    for object, gui in pairs(
        ESPObjects
    ) do

        pcall(function()
            gui:Destroy()
        end)

        ESPObjects[object] = nil
    end
end


local function RefreshESP()

    ClearESP()

    if not State.ESP then
        return
    end


    for _, egg in ipairs(
        State.Eggs
    ) do

        local object =
            egg.Object

        if object
            and object.Parent then

            local adornee

            if object:IsA(
                "BasePart"
            ) then

                adornee = object

            else

                adornee =
                    object:
                    FindFirstChildWhichIsA(
                        "BasePart",
                        true
                    )
            end


            if adornee then

                local billboard =
                    Instance.new(
                        "BillboardGui"
                    )

                billboard.Name =
                    "VensHubEggESP"

                billboard.Adornee =
                    adornee

                billboard.Size =
                    UDim2.fromOffset(
                        135,
                        34
                    )

                billboard.StudsOffset =
                    Vector3.new(
                        0,
                        3,
                        0
                    )

                billboard.AlwaysOnTop =
                    true

                billboard.Parent =
                    ScreenGui


                local text =
                    Instance.new(
                        "TextLabel"
                    )

                text.Size =
                    UDim2.fromScale(
                        1,
                        1
                    )

                text.BackgroundColor3 =
                    C.Black

                text.BackgroundTransparency =
                    0.15

                text.TextColor3 =
                    C.PurpleText

                text.TextStrokeTransparency =
                    0.4

                text.Font =
                    Enum.Font.GothamBold

                text.TextSize = 10

                text.Text =
                    egg.Name
                    .. "\n"
                    .. math.floor(
                        egg.Distance
                    )
                    .. " studs"

                text.Parent =
                    billboard

                Corner(text, 7)

                ESPObjects[object] =
                    billboard
            end
        end
    end
end


