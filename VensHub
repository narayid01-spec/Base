local function StartAutoEgg()

    if AutoCount() <= 0 then

        AutoStatus.Text =
            "Status: Select egg first"

        return
    end


    StopAuto()

    State.AutoToken += 1

    local token =
        State.AutoToken

    State.AutoEgg = true

    AutoEggButton.Text =
        "AUTO EGG  •  ON"

    AutoEggButton.BackgroundColor3 =
        C.Selected

    AutoEggButton:SetAttribute(
        "VensSelected",
        true
    )

    AutoStatus.Text =
        "Status: AUTO EGG"

    DashAuto.Text =
        "Auto: Egg"

    AddActivity(
        "Auto Egg started",
        tostring(
            AutoCount()
        ) .. " egg types",
        "AUTO"
    )


    task.spawn(function()

        local processed = {}


        while
            State.AutoEgg
            and token ==
                State.AutoToken
        do

            ScanAndRefresh()


            for object in pairs(
                processed
            ) do

                if not object
                    or not object.Parent then

                    processed[object] =
                        nil
                end
            end


            local target


            for _, egg in ipairs(
                State.Eggs
            ) do

                local key =
                    NormalizeName(
                        egg.Name
                    )

                if State.AutoSelected[key]
                    and egg.Object
                    and egg.Object.Parent
                    and not processed[
                        egg.Object
                    ] then

                    target = egg

                    break
                end
            end


            if not target then

                AutoStatus.Text =
                    "Status: Waiting..."

                task.wait(0.6)

                continue
            end


            State.AutoCount += 1

            AutoStatus.Text =
                "Taking: "
                .. target.Name


            StopTravel()

            local reached =
                TravelToEgg(
                    target.Object
                )


            if reached
                and State.AutoEgg
                and token ==
                    State.AutoToken then

                task.wait(0.1)

                local success =
                    Interact(
                        target.Object
                    )

                if success then

                    processed[
                        target.Object
                    ] = true

                    AddActivity(
                        "Auto Egg",
                        target.Name,
                        "AUTO"
                    )

                    task.wait(0.2)

                    if State.Spawn
                        and State.AutoEgg
                        and token ==
                            State.AutoToken then

                        ReturnToSpawn()
                    end

                else

                    AddActivity(
                        "Auto interaction failed",
                        target.Name,
                        "ERROR"
                    )

                    task.wait(0.5)
                end
            else

                task.wait(0.3)
            end
        end
    end)
end


local function StartAutoInstant()

    if AutoCount() <= 0 then

        AutoStatus.Text =
            "Status: Select egg first"

        return
    end


    StopAuto()

    State.AutoToken += 1

    local token =
        State.AutoToken

    State.AutoInstant = true

    AutoInstantButton.Text =
        "INSTANT  •  ON"

    AutoInstantButton.BackgroundColor3 =
        C.Selected

    AutoInstantButton:SetAttribute(
        "VensSelected",
        true
    )

    AutoStatus.Text =
