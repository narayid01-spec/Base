    AddActivity(
        "Auto Instant started",
        tostring(
            AutoCount()
        ) .. " egg types",
        "AUTO"
    )


    task.spawn(function()

        local processed = {}


        while
            State.AutoInstant
            and token ==
                State.AutoToken
        do

            ScanAndRefresh()


            local target


            for _, egg in ipairs(
                State.Eggs
            ) do

                local key =
                    NormalizeName(
                        egg.Name
                    )

                if State.AutoSelected[key]
                    and egg.Object
                    and egg.Object.Parent
                    and not processed[
                        egg.Object
                    ] then

                    target = egg

                    break
                end
            end


            if not target then

                AutoStatus.Text =
                    "Status: Waiting..."

                task.wait(0.6)

                continue
            end


            local root =
                GetRoot()

            local position =
                GetObjectPosition(
                    target.Object
                )


            if root and position then

                State.InstantCount += 1

                AutoStatus.Text =
                    "Instant: "
                    .. target.Name


                root.CFrame =
                    CFrame.new(
                        position
                        + Vector3.new(
                            0,
                            3,
                            0
                        )
                    )

                root.AssemblyLinearVelocity =
                    Vector3.zero

                task.wait(0.12)


                local success =
                    Interact(
                        target.Object
                    )


                if success then

                    processed[
                        target.Object
                    ] = true

                    AddActivity(
                        "Instant Egg",
                        target.Name,
                        "AUTO"
                    )


                    task.wait(0.2)


                    if State.Spawn
                        and State.AutoInstant
                        and token ==
                            State.AutoToken then

                        root =
                            GetRoot()

                        if root then

                            root.CFrame =
                                State.Spawn

                            root.AssemblyLinearVelocity =
                                Vector3.zero
                        end
                    end

                else

                    AddActivity(
                        "Instant interaction failed",
                        target.Name,
                        "ERROR"
                    )

                    task.wait(0.5)
                end
            end
        end
    end)
