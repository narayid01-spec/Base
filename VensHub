local function LoadActivity()

    State.Activity = {}

    if not readfile
        or not isfile then

        return
    end

    local exists = false

    pcall(function()
        exists = isfile(ACTIVITY_FILE)
    end)

    if not exists then
        return
    end

    local content

    local success =
        pcall(function()
            content =
                readfile(ACTIVITY_FILE)
        end)

    if not success
        or type(content) ~= "string"
        or content == "" then

        return
    end

    local decoded

    local decodeSuccess =
        pcall(function()

            decoded =
                HttpService:JSONDecode(
                    content
                )
        end)

    if decodeSuccess
        and type(decoded) == "table" then

        State.Activity = decoded
    end
end


local function SaveActivity()

    if not writefile then
        return
    end

    local encoded

    local success =
        pcall(function()

            encoded =
                HttpService:JSONEncode(
                    State.Activity
                )
        end)

    if not success
        or not encoded then

        return
    end

    pcall(function()
        writefile(
            ACTIVITY_FILE,
            encoded
        )
    end)
end


local function AddActivity(
    title,
    detail,
    kind
)

    local item = {
        title = tostring(title or "Activity"),
        detail = tostring(detail or ""),
        kind = tostring(kind or "INFO"),
        time = os.date("%H:%M:%S"),
        timestamp = os.time(),
    }

    table.insert(
        State.Activity,
        item
    )

    while #State.Activity >
        ACTIVITY_LIMIT do

        table.remove(
            State.Activity,
            1
        )
    end

    SaveActivity()
end


