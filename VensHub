--========================================================
-- INTERACTION
--========================================================

local function FindInteraction(object)

    if not object then
        return nil
    end

    if object:IsA(
        "ProximityPrompt"
    )
    or object:IsA(
        "ClickDetector"
    ) then

        return object
    end

    local prompt =
        object:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if prompt then
        return prompt
    end

    return object:FindFirstChildWhichIsA(
        "ClickDetector",
        true
    )
end


local function Interact(object)

    local interaction =
        FindInteraction(object)

    if not interaction then
        return false
    end


    if interaction:IsA(
        "ProximityPrompt"
    ) then

        if typeof(
            fireproximityprompt
        ) == "function" then

            local success =
                pcall(function()

                    fireproximityprompt(
                        interaction,
                        1,
                        true
                    )
                end)

            if success then

                State.InteractionCount += 1

                return true
            end
        end


        local success =
            pcall(function()

                interaction:
                    InputHoldBegin()

                task.wait(
                    math.max(
                        0.08,
                        tonumber(
                            interaction.HoldDuration
                        )
                        or 0.08
                    )
                )

                interaction:
                    InputHoldEnd()
            end)

        if success then
            State.InteractionCount += 1
        end

        return success
    end


    if interaction:IsA(
        "ClickDetector"
    )
    and typeof(
        fireclickdetector
    ) == "function" then

        local success =
            pcall(function()

                fireclickdetector(
                    interaction
                )
            end)

        if success then
            State.InteractionCount += 1
        end

        return success
    end

    return false
end


--========================================================
-- TRAVEL
--========================================================

local function StopTravel()

    State.TravelToken += 1

    State.Travel = false
    State.Returning = false

    local root =
        GetRoot()

    if root then
        root.AssemblyLinearVelocity =
            Vector3.zero
    end

    DashTravel.Text =
        "Travel: Stopped"
end


local function TravelToEgg(object)

    if not object
        or not object.Parent then

        return false
    end

    local root =
        GetRoot()

    if not root then
        return false
    end

    State.TravelToken += 1

    local token =
        State.TravelToken

    State.Travel = true
    State.Returning = false

    State.TravelCount += 1

    DashTravel.Text =
        "Travel: Travelling"

    AddActivity(
        "Travel started",
        GetEggName(object)
            or "Unknown Egg",
        "TRAVEL"
    )


    while
        State.Travel
        and token ==
            State.TravelToken
        and object
        and object.Parent
    do

        root = GetRoot()

        if not root then
            break
        end

        local position =
            GetObjectPosition(object)

        if not position then
            break
        end

        local offset =
            position - root.Position

        local distance =
            offset.Magnitude

        if distance <= 7 then

            root.AssemblyLinearVelocity =
                Vector3.zero

            DashTravel.Text =
                "Travel: Arrived"

            return true
        end

        if distance > 0 then

            root.AssemblyLinearVelocity =
                offset.Unit
                * math.clamp(
                    State.TravelSpeed,
                    1,
                    1000
                )
        end

        RunService.Heartbeat:Wait()
    end

    if root then
        root.AssemblyLinearVelocity =
            Vector3.zero
    end

    return false
end


local function ReturnToSpawn()

    if not State.Spawn then

        if not SaveSpawn() then
            return false
        end
    end

    local root =
        GetRoot()

    if not root then
        return false
    end

    State.TravelToken += 1

    local token =
        State.TravelToken

    State.Travel = true
    State.Returning = true

    DashTravel.Text =
        "Travel: Returning"

    local target =
        State.Spawn.Position


    while
        State.Travel
        and State.Returning
        and token ==
            State.TravelToken
    do

        root = GetRoot()

        if not root then
            break
        end

        local offset =
            target - root.Position

        local distance =
            offset.Magnitude

        if distance <= 7 then

            root.CFrame =
                State.Spawn

            root.AssemblyLinearVelocity =
                Vector3.zero

            State.Travel = false
            State.Returning = false

            DashTravel.Text =
                "Travel: At Spawn"

            AddActivity(
                "Returned to spawn",
                "Saved spawn",
                "TRAVEL"
            )

            return true
        end

        if distance > 0 then

            root.AssemblyLinearVelocity =
                offset.Unit
                * math.clamp(
                    State.TravelSpeed,
                    1,
                    1000
                )
        end

        RunService.Heartbeat:Wait()
    end

    if root then
        root.AssemblyLinearVelocity =
            Vector3.zero
    end

    return false
end


local function TakeSelectedEgg()

    if not State.SelectedEgg then

        DashTravel.Text =
            "Travel: Select an egg"

        return
    end

    local object =
        State.SelectedObject

    if not object
        or not object.Parent then

        ScanAndRefresh()

        object =
            State.SelectedObject
    end

    if not object then

        DashTravel.Text =
            "Travel: Egg Not Found"

        return
    end


    task.spawn(function()

        StopTravel()

        local reached =
            TravelToEgg(object)

        if reached
            and object
            and object.Parent then

            task.wait(0.12)

            local success =
                Interact(object)

            if success then

                AddActivity(
                    "Egg interaction",
                    GetEggName(object)
                        or "Egg",
                    "TAKE"
                )
            else

                AddActivity(
                    "Interaction failed",
                    GetEggName(object)
                        or "Egg",
                    "ERROR"
                )
            end
        end
    end)
end


