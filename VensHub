local function UpdateCharacter()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    State.Character = character

    State.Humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    State.Root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )
end


local function GetRoot()

    if not State.Character
        or not State.Character.Parent
        or not State.Root
        or not State.Root.Parent then

        UpdateCharacter()
    end

    return State.Root
end


local function SaveSpawn()

    local root = GetRoot()

    if not root then
        return false
    end

    State.Spawn = root.CFrame

    return true
end


