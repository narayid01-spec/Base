local function ScanAndRefresh(force)
local results = ScanEggs()
local signatureTable = {}

for _, egg in ipairs(results) do
signatureTable[#signatureTable + 1] =
NormalizeName(egg.Name)
.. ":"
.. math.floor(egg.Position.X / 15)
.. ":"
.. math.floor(egg.Position.Y / 15)
.. ":"
.. math.floor(egg.Position.Z / 15)
end

local signature = table.concat(signatureTable, "|")
State.Eggs = results
if RebuildAutoNames then
    RebuildAutoNames()
end

if State.SelectedObject and not State.SelectedObject.Parent then
    State.SelectedObject = nil
    State.SelectedEgg = nil
    if SelectedLabel and SelectedLabel.Parent then
        SelectedLabel.Text = "Selected: None"
    end
    if DashSelected and DashSelected.Parent then
        DashSelected.Text = "Selected Egg: None"
    end
end

-- EggMap keeps the nearest physical egg for each normalized name.
-- State.Eggs still contains every physical egg, so Travel/ESP are unaffected.
State.EggMap = {}
for _, egg in ipairs(results) do
local key = NormalizeName(egg.Name)
local previous = State.EggMap[key]
if not previous or egg.Distance < previous.Distance then
State.EggMap[key] = egg
end
end

if force or signature ~= State.LastScanSignature then
State.LastScanSignature = signature
RefreshEggList()
if AutoSelector and AutoSelector.Visible and RefreshAutoSelector then
    RefreshAutoSelector()
end
if State.ESP then RefreshESP() end
end
return results
end

local function FindSelectedEgg()
if State.SelectedObject and State.SelectedObject.Parent and State.SelectedEgg then
local name = GetEggName(State.SelectedObject)
if name and NormalizeName(name) == NormalizeName(State.SelectedEgg) then
return State.SelectedObject
end
end

if State.SelectedEgg then
local wanted = NormalizeName(State.SelectedEgg)
for _, egg in ipairs(State.Eggs) do
if NormalizeName(egg.Name) == wanted then
State.SelectedObject = egg.Object
return egg.Object
end
end
end
return nil
end

local function FindInteraction(object)
if not object then return nil end
if object:IsA("ProximityPrompt") or object:IsA("ClickDetector") then
return object
end
local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
if prompt then return prompt end
return object:FindFirstChildWhichIsA("ClickDetector", true)
end

local function Interact(object)
    if not object or not object.Parent then
        return false
    end

    local interaction = FindInteraction(object)
    if not interaction or not interaction.Parent then
        return false
    end

    if interaction:IsA("ProximityPrompt") then
        if typeof(fireproximityprompt) == "function" then
            local success = pcall(function()
                fireproximityprompt(interaction, 1, true)
            end)
            if success then
                return true
            end
        end

        local success = pcall(function()
            interaction:InputHoldBegin()
            task.wait(math.max(0.08, tonumber(interaction.HoldDuration) or 0.08))
            interaction:InputHoldEnd()
        end)
        return success
    end

    if interaction:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
        return pcall(function()
            fireclickdetector(interaction)
        end)
    end

    return false
end

local function StopTravel()
    State.Travel = false
    State.Returning = false
    State.TravelToken += 1

    local root = GetRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
    end

    if DashTravel and DashTravel.Parent then
        DashTravel.Text = "Travel: Stopped"
    end
end

local function TravelToEgg(object)
if not object or not object.Parent then return false end
local root = GetRoot()
if not root then return false end

State.TravelToken += 1
local token = State.TravelToken
State.Travel = true
State.Returning = false
DashTravel.Text = "Travel: Travelling to Egg"

while State.Travel and not State.Returning and token == State.TravelToken and object and object.Parent do
root = GetRoot()
if not root then break end
local position = GetObjectPosition(object)
if not position then break end
local offset = position - root.Position
local distance = offset.Magnitude
if distance <= 7 then
root.AssemblyLinearVelocity = Vector3.zero
return true
end
if distance > 0 then
root.AssemblyLinearVelocity = offset.Unit * math.clamp(State.TravelSpeed, 1, 1000)
end
RunService.Heartbeat:Wait()
end

if root then root.AssemblyLinearVelocity = Vector3.zero end
return false
end

local function ReturnToSpawn()
if not State.Spawn then SaveSpawn() end
if not State.Spawn then return false end
local root = GetRoot()
if not root then return false end

State.TravelToken += 1
local token = State.TravelToken
State.Travel = true
State.Returning = true
DashTravel.Text = "Travel: Returning to Spawn"

local target = State.Spawn.Position

while State.Travel and State.Returning and token == State.TravelToken do
root = GetRoot()
if not root then break end
local offset = target - root.Position
local distance = offset.Magnitude

if distance <= 7 then
root.CFrame = State.Spawn
root.AssemblyLinearVelocity = Vector3.zero
State.Travel = false
State.Returning = false
DashTravel.Text = "Travel: At Spawn"
return true
end

if distance > 0 then
root.AssemblyLinearVelocity = offset.Unit * math.clamp(State.TravelSpeed, 1, 1000)
end
RunService.Heartbeat:Wait()
end

if root then root.AssemblyLinearVelocity = Vector3.zero end
return false
end

