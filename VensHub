local function ScanEggs()

    local root =
        GetRoot()

    if not root then
        return {}
    end

    State.ScanCount += 1

    local results = {}
    local seen = {}

    for object in pairs(
        State.EggCandidates
    ) do

        if object
            and object.Parent
            and not IsLocalCharacterObject(object) then

            local eggName =
                GetEggName(object)

            local position =
                GetObjectPosition(object)

            if eggName and position then

                local distance =
                    (
                        position
                        - root.Position
                    ).Magnitude

                if distance >
                    MIN_SCAN_DISTANCE then

                    if not seen[object] then

                        seen[object] = true

                        table.insert(
                            results,
                            {
                                Name = eggName,
                                Object = object,
                                Position = position,
                                Distance = distance,
                            }
                        )
                    end
                end
            end
        end
    end

    table.sort(
        results,
        function(a, b)

            if a.Distance ==
                b.Distance then

                return NormalizeName(
                    a.Name
                ) <
                NormalizeName(
                    b.Name
                )
            end

            return a.Distance <
                b.Distance
        end
    )

    return results
end


