local function NormalizeName(value)
value = tostring(value or "")
value = value:gsub("[%c]", "")
value = value:gsub("%s+", " ")
value = value:match("^%s*(.-)%s*$") or ""
return string.lower(value)
end

local function GetEggName(object)
if not object then return nil end
local normalized = NormalizeName(object.Name)
if EggLookup[normalized] then
return EggLookup[normalized]
end
if normalized:find("egg", 1, true) then
return object.Name
end
return nil
end

local function GetObjectPosition(object)
if not object or not object.Parent then return nil end
if object:IsA("BasePart") then return object.Position end
if object:IsA("Model") then
local ok, pivot = pcall(function()
return object:GetPivot()
end)
if ok and pivot then return pivot.Position end
end
local part = object:FindFirstChildWhichIsA("BasePart", true)
if part then return part.Position end
return nil
end

local function IsInsideLocalCharacter(object)
    local character = LocalPlayer.Character
    return character and object:IsDescendantOf(character)
end

local function GetEggContainer(object)
    if not object then return nil end

    local current = object
    while current and current ~= workspace do
        if current:IsA("Model") and GetEggName(current) then
            return current
        end
        current = current.Parent
    end

    if object:IsA("BasePart") and GetEggName(object) then
        return object
    end

    return nil
end

local function TryAddCandidate(object)
    if not object then return end
    if IsInsideLocalCharacter(object) then return end

    local candidate = GetEggContainer(object)
    if candidate and candidate.Parent then
        State.EggCandidates[candidate] = true
    end
end

task.spawn(function()
local descendants = workspace:GetDescendants()
for i = 1, #descendants do
TryAddCandidate(descendants[i])
if i % 500 == 0 then task.wait() end
end
end)

Connect(workspace.DescendantAdded, function(object)
TryAddCandidate(object)
end)

Connect(workspace.DescendantRemoving, function(object)
    State.EggCandidates[object] = nil
    local candidate = GetEggContainer(object)
    if candidate then
        State.EggCandidates[candidate] = nil
    end
end)

