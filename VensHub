local function StartAutoEgg()
StopAuto()
State.AutoToken += 1
local token = State.AutoToken
State.AutoEgg = true
AutoEggButton.Text = "AUTO EGG  •  ON"
AutoInstantButton.Text = "INSTANT: OFF"
DashAuto.Text = "Auto: Egg"

task.spawn(function()
local processed = {}

while token == State.AutoToken and State.AutoEgg do
if AutoCount() <= 0 then
AutoStatus.Text = "Status: Select egg first"
task.wait(0.5)
continue
end

ScanAndRefresh(false)

for object in pairs(processed) do
if not object or not object.Parent then
processed[object] = nil
end
end

local target
for _, egg in ipairs(State.Eggs) do
local key = NormalizeName(egg.Name)
if State.AutoSelected[key]
and egg.Object
and egg.Object.Parent
and egg.Distance > MIN_SCAN_DISTANCE
and not processed[egg.Object] then
target = egg
break
end
end

if not target then
AutoStatus.Text = "Status: Egg Not Found"
task.wait(0.5)
continue
end

local object = target.Object
AutoStatus.Text = "Status: Taking " .. target.Name
StopTravel()

local reached = TravelToEgg(object)

if reached and token == State.AutoToken and State.AutoEgg and object and object.Parent then
    task.wait(0.12)
    local interacted = Interact(object)
    if interacted then
        processed[object] = true
        task.wait(0.2)
        if State.Spawn then ReturnToSpawn() end
    else
        AutoStatus.Text = "Status: Interaction Failed"
        task.wait(0.35)
    end
end

while token == State.AutoToken and State.AutoEgg and object and object.Parent do
task.wait(0.25)
end
end
end)
end

local function InstantTeleportAndInteract(object)
if not object or not object.Parent then return false end
local root = GetRoot()
if not root then return false end
local position = GetObjectPosition(object)
if not position then return false end

root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
root.AssemblyLinearVelocity = Vector3.zero
task.wait(0.15)

local interaction = FindInteraction(object)
if not interaction then
task.wait(0.15)
interaction = FindInteraction(object)
end
if not interaction then return false end

local interacted = Interact(object)
task.wait(0.15)

root = GetRoot()
if root and State.Spawn then
root.CFrame = State.Spawn
root.AssemblyLinearVelocity = Vector3.zero
end
return interacted
end

local function StartAutoInstant()
State.AutoEgg = false
State.AutoInstant = false
State.AutoToken += 1
local token = State.AutoToken
State.AutoInstant = true
AutoEggButton.Text = "AUTO EGG  •  OFF"
AutoInstantButton.Text = "INSTANT  •  ON"
AutoEggButton.BackgroundColor3 = C.Button
AutoInstantButton.BackgroundColor3 = C.Selected
AutoEggButton:SetAttribute("VensSelected", false)
AutoInstantButton:SetAttribute("VensSelected", true)
DashAuto.Text = "Auto: Instant"

task.spawn(function()
local processed = {}

while token == State.AutoToken and State.AutoInstant do
if AutoCount() <= 0 then
AutoStatus.Text = "Status: Select egg first"
task.wait(0.5)
continue
end

ScanAndRefresh(false)

for object in pairs(processed) do
if not object or not object.Parent then
processed[object] = nil
end
end

local target
for _, egg in ipairs(State.Eggs) do
local key = NormalizeName(egg.Name)
if State.AutoSelected[key]
and egg.Object
and egg.Object.Parent
and egg.Distance > MIN_SCAN_DISTANCE
and not processed[egg.Object] then
target = egg
break
end
end

if not target then
AutoStatus.Text = "Status: Egg Not Found"
task.wait(0.5)
continue
end

local object = target.Object
AutoStatus.Text = "Status: Taking " .. target.Name
StopTravel()

-- Original source calls StopFly() here, but StopFly is defined later.
-- This line is retained exactly in logic by a forward declaration below.
if State.Fly and StopFly then
    StopFly()
end

local success = InstantTeleportAndInteract(object)

if success then
    processed[object] = true
    AutoStatus.Text = "Status: Taken " .. target.Name
else
    AutoStatus.Text = "Status: Interaction Failed"
    task.wait(0.6)
    continue
end

local timeout = os.clock()
while token == State.AutoToken
and State.AutoInstant
and object
and object.Parent
and (os.clock() - timeout) < 5 do
task.wait(0.15)
end
task.wait(0.25)
end
end)
end

local AutoNames = {}
local SelectorConnections = {}

local function ClearSelectorConnections()
    for _, connection in ipairs(SelectorConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    for i = #SelectorConnections, 1, -1 do
        SelectorConnections[i] = nil
    end
end

local function SelectorConnect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(SelectorConnections, connection)
    return connection
end

RebuildAutoNames = function()
    local names = {}

    -- Only names currently found by the shared >500-stud scanner.
    -- Multiple physical eggs with the same normalized name collapse into one entry.
    for _, egg in ipairs(State.Eggs) do
        local key = NormalizeName(egg.Name)
        if key ~= "" and not names[key] then
            names[key] = egg.Name
        end
    end

    AutoNames = names
end

local function UpdateAutoSelection()
    local count = AutoCount()
    AutoSelectedLabel.Text = "Selected Eggs: " .. count
    SelectorCount.Text = tostring(count) .. " selected"
end

RefreshAutoSelector = function()
    ClearSelectorConnections()

    for _, child in ipairs(SelectorList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    RebuildAutoNames()

    local names = {}
    for _, name in pairs(AutoNames) do
        names[#names + 1] = name
    end
    table.sort(names, function(a,b)
        return NormalizeName(a) < NormalizeName(b)
    end)

    local search = NormalizeName(SelectorSearch.Text)
    local found = 0

    for _, eggName in ipairs(names) do
        local key = NormalizeName(eggName)
        if search == "" or key:find(search, 1, true) then
            found += 1
            local selected = State.AutoSelected[key] == true

            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1,-2,0,29)
            row.BackgroundColor3 = selected and C.Selected or C.Button
            row.BackgroundTransparency = selected and 0.02 or 0.04
            row.BorderSizePixel = 0
            row.Text = ""
            row.AutoButtonColor = false
            row.ZIndex = 84
            row.Parent = SelectorList
            Corner(row,7)
            Stroke(row, selected and C.Purple or Color3.fromRGB(48,42,60), 1, selected and 0.15 or 0.55)

            local checkBox = Instance.new("Frame")
            checkBox.Size = UDim2.fromOffset(20,20)
            checkBox.Position = UDim2.fromOffset(6,4)
            checkBox.BackgroundColor3 = selected and C.Purple or C.Panel2
            checkBox.BorderSizePixel = 0
            checkBox.ZIndex = 85
            checkBox.Parent = row
            Corner(checkBox,6)

            local check = Label(checkBox, selected and "✓" or "", UDim2.fromScale(1,1), UDim2.fromOffset(0,0), 11, C.White)
            check.TextXAlignment = Enum.TextXAlignment.Center
            check.ZIndex = 86

            local nameLabel = Label(row, eggName, UDim2.new(1,-40,1,0), UDim2.fromOffset(34,0), 10, C.White)
            nameLabel.ZIndex = 85

            SelectorConnect(row.Activated,function()
                State.AutoSelected[key] = not State.AutoSelected[key]
                UpdateAutoSelection()
                RefreshAutoSelector()
            end)
        end
    end

    if found == 0 then
        local empty = Label(
            SelectorList,
            "No egg type found",
            UDim2.new(1,-10,0,30),
            UDim2.fromOffset(5,5),
            10,
            C.Gray
        )
        empty.TextXAlignment = Enum.TextXAlignment.Center
        empty.ZIndex = 84
    end

    UpdateAutoSelection()
end

local function SetAllAutoEggs(value)
    if value then
        for key in pairs(AutoNames) do
            State.AutoSelected[key] = true
        end
    else
        for key in pairs(State.AutoSelected) do
            State.AutoSelected[key] = nil
        end
    end
    RefreshAutoSelector()
end

local function OpenAutoSelector()
    if RefreshAutoSelector then
        RefreshAutoSelector()
    end
    AutoSelector.Visible = true
end

local function CloseAutoSelector()
    AutoSelector.Visible = false
end

local FlyConnection = nil

StopFly = function()
    State.Fly = false

    if FlyConnection then
        pcall(function()
            FlyConnection:Disconnect()
        end)
        FlyConnection = nil
    end

    local root = GetRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
    end

    if FlyButton and FlyButton.Parent then
        FlyButton.Text = "FLY: OFF"
        FlyButton.BackgroundColor3 = C.Button
        FlyButton:SetAttribute("VensSelected", false)
    end
end

local function StartFly()
    if State.Travel or State.Returning or IsAutoRunning() then
        return
    end

    StopFly()
    State.Fly = true
    FlyButton.Text = "FLY: ON"
    FlyButton.BackgroundColor3 = C.Selected
    FlyButton:SetAttribute("VensSelected", true)

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not State.Fly or State.Travel or State.Returning or IsAutoRunning() then
            return
        end

        local root = GetRoot()
        if not root then
            StopFly()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end

        if move.Magnitude > 0 then
            move = move.Unit
            root.AssemblyLinearVelocity = move * math.clamp(State.FlySpeed, 1, 1000)
        else
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

